{
  "name": "gil",
  "productName": "gil",
  "version": "0.8.0",
  "private": true,
  "description": "Capture anything on screen as a named, reusable design reference.",
  "license": "AGPL-3.0-only",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-extension.mjs && node scripts/check-build.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "package": "pnpm build && electron-builder --mac",
    "release": "node scripts/release.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "bench": "electron-vite build && electron out/main/bench.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
