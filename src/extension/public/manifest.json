{
  "manifest_version": 3,
  "name": "gil",
  "version": "0.1.0",
  "description": "Screenshot or record part of a tab and save it to your gil library.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "tabCapture", "offscreen", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Capture with gil" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Capture part of this tab"
    }
  },
  "options_page": "options.html"
}
